{
  "rewrites": [
    { "source": "/", "destination": "/views/public/index.html" },
    { "source": "/auth/:path*", "destination": "/views/auth/:path*" },
    { "source": "/app/:path*", "destination": "/views/app/:path*" },
    { "source": "/public/:path*", "destination": "/views/public/:path*" },
    { "source": "/public/:path*", "destination": "/views/public/:path*" },
    { "source": "/:path*", "destination": "/views/public/:path*" }
  ],
  "alias": ["pathwayai.vercel.app"]
}